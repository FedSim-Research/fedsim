{
  "architecture": "spyker",

  "dataset": {
    "name": "cifar10_iid",
    "path": "./data/cifar10",
    "split_strategy": "uniform",
    "mean_datapoints_per_user": 50
  },

  "model": {
    "name": "simple_cnn"
  },

  "servers": [
    {
      "id": 1,
      "region": "EU",
      "cpus": 4,
      "gpus": 1
    },
    {
      "id": 2,
      "region": "US",
      "cpus": 4,
      "gpus": 0
    }
  ],

  "clients": [
    {
      "type": "mobile",
      "count": 50,
      "region": "EU"
    },
    {
      "type": "desktop",
      "count": 150,
      "region": "US"
    }
  ],

  "network": {
    "latency_matrix": {
      "EU": { "EU": 20, "US": 120, "ASIA": 200 },
      "US": { "EU": 120, "US": 15, "ASIA": 180 },
      "ASIA": { "EU": 200, "US": 180, "ASIA": 25 }
    },
    "packetloss": 0.02,
    "jitter": 10
  },

  "simulation": {
    "rounds": 50,
    "seed": 0,
    "evaluate_every": 10,
    "parallel_runs": 1,
    "local_epochs": 1,
    "local_learning_rate": 0.1,
    "central_learning_rate": 1.0,
    "batch_size": 10
  }
}