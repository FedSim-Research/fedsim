{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1008,
      "type": "timeseries",
      "title": "Accuracy & Loss",
      "transparent": true,
      "timeFrom": "500s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 8,
        "w": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Loss"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({job=\"fedsim-evaluation\", filename=~\".*sim_${run_id}.*\"} | json accuracy=\"accuracy\" | unwrap accuracy [5m])",
          "legendFormat": "Accuracy",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({job=\"fedsim-evaluation\", filename=~\".*sim_${run_id}.*\"} | json loss=\"loss\" | unwrap loss [5m])",
          "legendFormat": "Loss",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code"
        }
      ],
      "datasource": {
        "uid": "Loki",
        "type": "loki"
      },
      "options": {
        "show": "lines",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "style": "dark",
  "tags": [
    "frontend"
  ],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "textbox",
        "label": "Run ID Regex",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Frontend Dashboard",
  "uid": "fedsimFrontendDashboard",
  "version": 1,
  "weekStart": ""
}
