    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@primeuix/themes": "2.0.3",
    "ngx-selecto": "1.26.3",
    "ngx-vflow": "2.7.0",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "selecto": "1.26.3",
    "tslib": "2.9.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
